---
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import CapabilityProof from '../components/home/CapabilityProof.astro';
import ContactCta from '../components/home/ContactCta.astro';
import CurrentFocus from '../components/home/CurrentFocus.astro';
import FlagshipLeen from '../components/home/FlagshipLeen.astro';
import Hero from '../components/home/Hero.astro';
import OperatorProfilePreview from '../components/home/OperatorProfilePreview.astro';
import PrinciplesTrack from '../components/home/PrinciplesTrack.astro';
import SupportingSystems from '../components/home/SupportingSystems.astro';
---

<BaseLayout title={site.title} description={site.description}>
  <Hero />
  <FlagshipLeen />
  <CapabilityProof />
  <SupportingSystems />
  <PrinciplesTrack />
  <OperatorProfilePreview />
  <CurrentFocus />
  <ContactCta />
</BaseLayout>

---
import ProfilePageCta from '../components/profile/ProfilePageCta.astro';
import ProfilePageShell from '../components/profile/ProfilePageShell.astro';
import ResumeBody from '../components/resume/ResumeBody.astro';
import ResumeHeader from '../components/resume/ResumeHeader.astro';
import ActionGroup from '../components/ui/ActionGroup.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import TextLink from '../components/ui/TextLink.astro';
import { profileIdentity } from '../config/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
import { canonicalUrl } from '../lib/seo';
import '../styles/print.css';

const title = `Résumé | ${profileIdentity.fullName}`;
const description =
  'Structured career record for Abdul Rasheed Keramat — experience, education, technical stack, and selected engineering work.';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl('/resume/')}
  ogTitle={title}
  ogDescription={description}
>
  <ProfilePageShell>
    <div class="resume-document">
      <ResumeHeader />
      <ResumeBody />
      <div class="resume-screen-only">
        <ProfilePageCta>
          Engineering publications provide deeper context on platform and project work.
          <ActionGroup slot="actions">
            <ButtonLink href="/work/" variant="primary">Browse work</ButtonLink>
            <TextLink href="/contact/">Contact →</TextLink>
          </ActionGroup>
        </ProfilePageCta>
      </div>
    </div>
  </ProfilePageShell>
</BaseLayout>

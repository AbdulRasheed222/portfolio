---
import { site } from '../config/site';
import PlaceholderPage from '../components/layout/PlaceholderPage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = `Résumé | ${site.ownerName}`;
const description = 'The public résumé and downloadable PDF are being prepared.';
---

<BaseLayout title={title} description={description}>
  <PlaceholderPage
    eyebrow="Résumé"
    title="Résumé"
    message="The public résumé and downloadable PDF are being prepared."
  />
</BaseLayout>

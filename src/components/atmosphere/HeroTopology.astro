---
import styles from './HeroTopology.module.css';
---

<svg
  class={styles.topology}
  viewBox="0 0 1200 520"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="heroEdge" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="rgba(201, 168, 106, 0.35)" />
      <stop offset="35%" stop-color="rgba(45, 91, 255, 0.55)" />
      <stop offset="65%" stop-color="rgba(120, 180, 255, 0.65)" />
      <stop offset="100%" stop-color="rgba(244, 240, 232, 0.4)" />
    </linearGradient>
    <radialGradient id="archGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="rgba(45, 91, 255, 0.5)" />
      <stop offset="70%" stop-color="rgba(45, 91, 255, 0.08)" />
      <stop offset="100%" stop-color="rgba(7, 10, 16, 0)" />
    </radialGradient>
    <filter id="nodeGlow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  <!-- Architecture core glow -->
  <ellipse cx="520" cy="280" rx="140" ry="90" fill="url(#archGlow)" class={styles.archGlow} />

  <!-- Primary flow: Intent → Architecture → Execution → Evidence -->
  <g class={styles.edges} stroke="url(#heroEdge)" stroke-width="1.5" stroke-linecap="round">
    <path class={styles.flowPrimary} d="M 100 300 C 220 300, 300 280, 420 280" />
    <path class={styles.flowPrimary} d="M 420 280 C 480 280, 500 280, 520 280" />
    <path class={styles.flowPrimary} d="M 520 280 C 640 280, 720 290, 840 300" />
    <path class={styles.flowPrimary} d="M 840 300 C 920 305, 1000 310, 1100 310" />
    <!-- Secondary branches -->
    <path class={styles.flowSecondary} d="M 420 280 L 380 220" />
    <path class={styles.flowSecondary} d="M 420 280 L 390 340" />
    <path class={styles.flowSecondary} d="M 520 280 L 520 200" />
    <path class={styles.flowSecondary} d="M 520 280 L 520 360" />
    <path class={styles.flowSecondary} d="M 840 300 L 820 240" />
    <path class={styles.flowSecondary} d="M 840 300 L 830 360" />
    <path class={styles.flowTertiary} d="M 380 220 L 350 180" />
    <path class={styles.flowTertiary} d="M 390 340 L 360 380" />
    <path class={styles.flowTertiary} d="M 820 240 L 800 200" />
  </g>

  <!-- Nodes with hierarchy -->
  <g class={styles.nodes}>
    <circle cx="100" cy="300" r="8" class={styles.nodeIntent} />
    <circle cx="420" cy="280" r="5" class={styles.nodeSecondary} />
    <circle cx="520" cy="280" r="14" class={styles.nodeArch} filter="url(#nodeGlow)" />
    <circle cx="840" cy="300" r="6" class={styles.nodeSecondary} />
    <circle cx="1100" cy="310" r="8" class={styles.nodeEvidence} />
    <!-- Branch nodes -->
    <circle cx="380" cy="220" r="3.5" class={styles.nodeTertiary} />
    <circle cx="390" cy="340" r="3.5" class={styles.nodeTertiary} />
    <circle cx="520" cy="200" r="3" class={styles.nodeTertiary} />
    <circle cx="520" cy="360" r="3" class={styles.nodeTertiary} />
    <circle cx="820" cy="240" r="3" class={styles.nodeTertiary} />
    <circle cx="830" cy="360" r="3" class={styles.nodeTertiary} />
  </g>

  <!-- Subtle stage labels -->
  <g class={styles.labels} fill="currentColor">
    <text x="100" y="340" text-anchor="middle">INTENT</text>
    <text x="520" y="340" text-anchor="middle">ARCHITECTURE</text>
    <text x="840" y="340" text-anchor="middle">EXECUTION</text>
    <text x="1100" y="350" text-anchor="middle">EVIDENCE</text>
  </g>
</svg>

---
import ButtonLink from '../ui/ButtonLink.astro';
import styles from './EvidencePhilosophy.module.css';
---

<section class={styles.section} aria-labelledby="registry-closing-title">
  <h2 class={styles.title} id="registry-closing-title">How to read this work</h2>
  <p class={styles.text}>
    Entries vary in depth — the flagship platform receives the most detail. Supporting case studies
    and project briefs stay concise. Contribution scope is stated explicitly in every entry.
  </p>

  <div class={styles.cta}>
    <ButtonLink href="/about/" variant="secondary">Operator profile</ButtonLink>
    <ButtonLink href="/contact/" variant="primary">Contact</ButtonLink>
  </div>
</section>

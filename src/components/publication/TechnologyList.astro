---
import styles from './TechnologyList.module.css';

interface Props {
  technologies: string[];
}

const { technologies } = Astro.props;
---

<div class={styles.block}>
  <h2 class={styles.title}>Technologies</h2>
  <ul class={styles.list}>
    {technologies.map((tech) => (
      <li>{tech}</li>
    ))}
  </ul>
</div>

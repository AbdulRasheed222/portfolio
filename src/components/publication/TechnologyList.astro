---
import styles from './TechnologyList.module.css';

interface Props {
  technologies: string[];
  variant?: 'default' | 'compact';
}

const { technologies, variant = 'default' } = Astro.props;
---

<div class:list={[styles.block, variant === 'compact' && styles.compact]}>
  <p class={styles.label}>{variant === 'compact' ? 'Stack' : 'Technologies'}</p>
  <ul class={styles.list}>
    {technologies.map((tech) => (
      <li>{tech}</li>
    ))}
  </ul>
</div>

---
import type { PublicationEntry } from '../../lib/publications';
import { formatLabel, statusVariant } from '../../lib/publications';
import { withBasePath } from '../../lib/url';
import ButtonLink from '../ui/ButtonLink.astro';
import StatusChip from '../ui/StatusChip.astro';
import TextLink from '../ui/TextLink.astro';
import styles from './PublicationOpeningBand.module.css';

interface Props {
  publication: PublicationEntry['data'];
}

const { publication } = Astro.props;

const variant = statusVariant(publication.status);

const isBrief = publication.format === 'project-brief';
const isFlagship = publication.format === 'flagship';
const accentClass = publication.accent
  ? styles[`accent${publication.accent.charAt(0).toUpperCase()}${publication.accent.slice(1)}`]
  : '';
---

<header
  class:list={[
    styles.band,
    isFlagship && styles.flagship,
    isBrief && styles.brief,
    accentClass,
  ]}
>
  <div class={styles.inner}>
    <p class={styles.eyebrow}>
      <TextLink href={withBasePath('/work/')}>← Work</TextLink>
    </p>

    <div class={styles.chips}>
      <StatusChip variant="muted">{formatLabel(publication.format)}</StatusChip>
      <StatusChip variant={variant}>{publication.status}</StatusChip>
    </div>

    <h1 class={styles.title}>{publication.title}</h1>
    <p class={styles.summary}>{publication.summary}</p>

    <dl class={styles.facts}>
      <div class={styles.fact}>
        <dt>Role</dt>
        <dd>{publication.role}</dd>
      </div>
      {
        publication.timeframe && (
          <div class={styles.fact}>
            <dt>Timeframe</dt>
            <dd>{publication.timeframe}</dd>
          </div>
        )
      }
      {
        publication.readingTime && !isBrief && (
          <div class={styles.fact}>
            <dt>Reading time</dt>
            <dd>{publication.readingTime}</dd>
          </div>
        )
      }
      {
        !isBrief && (
          <div class={styles.fact}>
            <dt>Reference</dt>
            <dd>{publication.reference}</dd>
          </div>
        )
      }
    </dl>

    {
      publication.links && publication.links.length > 0 && (
        <div class={styles.links}>
          {publication.links.map((link, index) => (
            <ButtonLink
              href={link.href}
              variant={index === 0 ? 'primary' : 'secondary'}
              target="_blank"
            >
              {link.label} ↗
            </ButtonLink>
          ))}
        </div>
      )
    }

    {
      publication.maturityNotice && (
        <aside class={styles.maturity} role="note">
          <p>{publication.maturityNotice}</p>
        </aside>
      )
    }
  </div>
</header>

---
import { homepage } from '../../config/homepage';
import PageContainer from '../layout/PageContainer.astro';
import Section from '../layout/Section.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import TextLink from '../ui/TextLink.astro';
import styles from './ContactCta.module.css';

const { contactCta } = homepage;
---

<Section variant="spacious">
  <PageContainer>
    <div class={styles.panel}>
      <div class={styles.content}>
        <h2 class={styles.heading}>{contactCta.heading}</h2>
        <p class={styles.supporting}>{contactCta.supporting}</p>
        <div class={styles.actions}>
          <ButtonLink href="/resume/" variant="primary">{contactCta.primaryLabel}</ButtonLink>
          <TextLink href="/contact/">{contactCta.secondaryLabel}</TextLink>
        </div>
      </div>
    </div>
  </PageContainer>
</Section>

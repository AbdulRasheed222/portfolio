---
import { publicationPresentation } from '../../config/homepage';
import {
  getFlagshipPublication,
  getPublications,
  publicationPath,
} from '../../lib/publications';
import { withBasePath } from '../../lib/url';
import PageContainer from '../layout/PageContainer.astro';
import Section from '../layout/Section.astro';
import MetadataRail from '../ui/MetadataRail.astro';
import StatusChip from '../ui/StatusChip.astro';
import LeenArchitecture from './LeenArchitecture.astro';
import styles from './FlagshipLeen.module.css';

const publications = await getPublications();
const flagship = getFlagshipPublication(publications);

if (!flagship) {
  throw new Error('FlagshipLeen: no flagship publication found in the content collection.');
}

const data = flagship.data;
const resolvedHref = withBasePath(publicationPath(data.slug));
const pubCode = publicationPresentation[data.slug]?.pub;
const metaItems = [
  data.reference,
  ...(pubCode ? [pubCode] : []),
  'TIER: FLAGSHIP',
  ...(data.readingTime ? [`READ ${data.readingTime}`] : []),
];
---

<Section id="flagship-leen" variant="spacious" mode="elevated" class={styles.section} reveal={false}>
  <PageContainer variant="wide">
    <div class={styles.labelRow}>
      <span class={styles.index}>02 — FLAGSHIP SYSTEM</span>
    </div>

    <article class={styles.panel}>
      <div class={styles.visual} aria-hidden="true">
        <LeenArchitecture />
      </div>

      <div class={styles.content}>
        <MetadataRail items={metaItems} />
        <div class={styles.chips}>
          <StatusChip variant="warning">{data.status}</StatusChip>
          <StatusChip variant="muted">FEATURED</StatusChip>
        </div>
        <h2 class={styles.title}>
          <a href={resolvedHref} class={styles.titleLink}>{data.title}</a>
        </h2>
        <p class={styles.summary}>{data.summary}</p>
        <span class={styles.cta} aria-hidden="true">Enter flagship publication →</span>
      </div>
    </article>
  </PageContainer>
</Section>

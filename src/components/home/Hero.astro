---
import { homepage } from '../../config/homepage';
import HeroTopology from '../atmosphere/HeroTopology.astro';
import PageContainer from '../layout/PageContainer.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import MetadataRail from '../ui/MetadataRail.astro';
import styles from './Hero.module.css';

const { hero } = homepage;
---

<section class={styles.hero} id="arrival" data-hero-parallax>
  <div class={styles.backdrop} aria-hidden="true">
    <div class={styles.topologyLayer} data-hero-topology>
      <HeroTopology />
    </div>
    <div class={styles.systemCore} data-hero-core>
      <div class={styles.coreLayer}></div>
      <div class={styles.coreLayer}></div>
      <div class={styles.coreFacet}></div>
    </div>
    <div class={styles.lightSweep}></div>
    <div class={styles.textScrim}></div>
  </div>

  <PageContainer variant="wide" class={styles.container}>
    <div class={styles.content}>
      <div class:list={[styles.meta, styles.stagger, styles.d1]}>
        <MetadataRail items={hero.metadata} />
      </div>
      <p class:list={[styles.eyebrow, styles.stagger, styles.d2]}>{hero.eyebrow}</p>
      <h1 class:list={[styles.title, styles.stagger, styles.d3]}>{hero.name}</h1>
      <p class:list={[styles.roleLead, styles.stagger, styles.d4]}>
        <span class={styles.rolePrimary}>{hero.rolePrimary}</span>
        <span class={styles.roleSecondary}>{hero.roleSecondary}</span>
      </p>
      <p class:list={[styles.supporting, styles.stagger, styles.d5]}>{hero.supporting}</p>
      <div class:list={[styles.actions, styles.stagger, styles.d6]}>
        <ButtonLink href="#flagship-leen" variant="primary">Explore Leen flagship</ButtonLink>
        <ButtonLink href="#supporting-systems" variant="secondary">View all systems</ButtonLink>
      </div>
    </div>
  </PageContainer>
</section>

<script>
  const hero = document.querySelector('[data-hero-parallax]');
  if (hero && window.matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    const layer = hero.querySelector('[data-hero-topology]') as HTMLElement | null;
    const core = hero.querySelector('[data-hero-core]') as HTMLElement | null;
    hero.addEventListener(
      'pointermove',
      (e) => {
        const rect = hero.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        const tx = x * 8;
        const ty = y * 5;
        if (layer) layer.style.transform = `translate3d(${tx}px, ${ty}px, 0)`;
        if (core) core.style.transform = `translate3d(${tx * 0.35}px, ${ty * 0.35}px, 0)`;
      },
      { passive: true },
    );
  }
</script>

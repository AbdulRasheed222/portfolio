---
import { publicationPresentation } from '../../config/homepage';
import {
  getPublications,
  getSupportingPublications,
  publicationPath,
} from '../../lib/publications';
import PageContainer from '../layout/PageContainer.astro';
import Section from '../layout/Section.astro';
import PublicationArtifact from '../ui/PublicationArtifact.astro';
import styles from './SupportingSystems.module.css';

const publications = await getPublications();
const supporting = getSupportingPublications(publications);
---

<Section id="supporting-systems" variant="spacious" class={styles.section}>
  <PageContainer variant="wide">
    <header class={styles.header}>
      <span class={styles.index}>04 — SUPPORTING SYSTEMS</span>
      <h2 class={styles.title}>Engineering publications</h2>
      <p class={styles.lead}>
        Prior systems and supporting work — each documented as an engineering publication.
      </p>
    </header>

    <div class={styles.grid}>
      {supporting.map((entry) => {
        const data = entry.data;
        const presentation = publicationPresentation[data.slug];
        return (
          <PublicationArtifact
            referenceId={data.reference}
            pub={presentation?.pub ?? data.reference}
            title={data.title}
            summary={data.summary}
            href={publicationPath(data.slug)}
            status={data.status}
            readTime={data.readingTime}
            layout={presentation?.layout}
            accent={data.accent}
          />
        );
      })}
    </div>
  </PageContainer>
</Section>

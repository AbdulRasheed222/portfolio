---
import styles from './LeenArchitecture.module.css';
---

<svg
  class={styles.architecture}
  viewBox="0 0 400 360"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="leenLayer" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="rgba(45, 91, 255, 0.35)" />
      <stop offset="100%" stop-color="rgba(12, 30, 61, 0.6)" />
    </linearGradient>
    <linearGradient id="leenEdge" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="rgba(120, 180, 255, 0.4)" />
      <stop offset="100%" stop-color="rgba(45, 91, 255, 0.1)" />
    </linearGradient>
  </defs>

  <!-- Vertical stack: Copilot → ... → Evidence -->
  <g class={styles.stack}>
  <rect x="120" y="24" width="160" height="32" rx="6" fill="url(#leenLayer)" stroke="url(#leenEdge)" stroke-width="1" />
  <line x1="200" y1="56" x2="200" y2="68" stroke="rgba(45, 91, 255, 0.4)" stroke-width="1" />
  <rect x="100" y="68" width="200" height="36" rx="6" fill="url(#leenLayer)" stroke="url(#leenEdge)" stroke-width="1" />
  <line x1="200" y1="104" x2="200" y2="116" stroke="rgba(45, 91, 255, 0.45)" stroke-width="1" />
  <rect x="80" y="116" width="240" height="40" rx="6" fill="url(#leenLayer)" stroke="url(#leenEdge)" stroke-width="1.25" class={styles.coreLayer} />
  <line x1="200" y1="156" x2="200" y2="168" stroke="rgba(45, 91, 255, 0.45)" stroke-width="1" />
  <rect x="100" y="168" width="200" height="36" rx="6" fill="url(#leenLayer)" stroke="url(#leenEdge)" stroke-width="1" />
  <line x1="200" y1="204" x2="200" y2="216" stroke="rgba(45, 91, 255, 0.4)" stroke-width="1" />
  <rect x="110" y="216" width="180" height="32" rx="6" fill="url(#leenLayer)" stroke="url(#leenEdge)" stroke-width="1" />
  <line x1="200" y1="248" x2="200" y2="260" stroke="rgba(45, 91, 255, 0.35)" stroke-width="1" />
  <rect x="130" y="260" width="140" height="28" rx="6" fill="url(#leenLayer)" stroke="url(#leenEdge)" stroke-width="1" />
  <line x1="200" y1="288" x2="200" y2="300" stroke="rgba(201, 168, 106, 0.35)" stroke-width="1" />
  <rect x="140" y="300" width="120" height="28" rx="6" fill="rgba(201, 168, 106, 0.12)" stroke="rgba(201, 168, 106, 0.35)" stroke-width="1" />
  </g>

  <!-- Connection hints -->
  <g class={styles.connections} stroke="rgba(45, 91, 255, 0.2)" stroke-width="0.75">
    <path d="M 80 134 L 60 134 L 60 200 L 80 200" />
    <path d="M 320 134 L 340 134 L 340 200 L 320 200" />
    <circle cx="60" cy="200" r="3" fill="rgba(45, 91, 255, 0.4)" />
    <circle cx="340" cy="200" r="3" fill="rgba(45, 91, 255, 0.4)" />
  </g>

  <g class={styles.labels} fill="currentColor">
    <text x="200" y="44" text-anchor="middle">COPILOT</text>
    <text x="200" y="90" text-anchor="middle">AGENT RUNTIME</text>
    <text x="200" y="140" text-anchor="middle">WORKFLOW ENGINE</text>
    <text x="200" y="190" text-anchor="middle">MEMORY</text>
    <text x="200" y="238" text-anchor="middle">APPS</text>
    <text x="200" y="280" text-anchor="middle">GOVERNANCE</text>
    <text x="200" y="318" text-anchor="middle">EVIDENCE</text>
  </g>
</svg>

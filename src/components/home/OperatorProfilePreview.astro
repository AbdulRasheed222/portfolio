---
import { Image } from 'astro:assets';
import { homepage } from '../../config/homepage';
import portrait from '../../assets/images/abdul-rasheed-keramat.png';
import PageContainer from '../layout/PageContainer.astro';
import Section from '../layout/Section.astro';
import MetadataRail from '../ui/MetadataRail.astro';
import TextLink from '../ui/TextLink.astro';
import styles from './OperatorProfilePreview.module.css';

const { operatorProfile } = homepage;
---

<Section id="operator-profile" mode="reading" class={styles.section}>
  <PageContainer variant="wide">
    <div class={styles.layout}>
      <div class={styles.portraitFrame}>
        <div class={styles.portraitGlow} aria-hidden="true"></div>
        <Image
          src={portrait}
          alt="Portrait of Abdul Rasheed Keramat, software engineer"
          width={422}
          height={591}
          class={styles.portrait}
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class={styles.content}>
        <span class={styles.index}>{operatorProfile.systemIndex}</span>
        <p class={styles.role}>{operatorProfile.role}</p>
        <h2 class={styles.title}>{operatorProfile.title}</h2>
        <p class={styles.summary}>{operatorProfile.summary}</p>
        <MetadataRail items={operatorProfile.metadata} class={styles.meta} />
        <TextLink href={operatorProfile.href}>Read operator profile →</TextLink>
      </div>
    </div>
  </PageContainer>
</Section>

---
import { homepage } from '../../config/homepage';
import PageContainer from '../layout/PageContainer.astro';
import Section from '../layout/Section.astro';
import styles from './ProfessionalFocus.module.css';

const { professionalFocus } = homepage;
---

<Section variant="compact">
  <PageContainer variant="reading">
    <div class={styles.band}>
      <p class={styles.heading}>Current focus</p>
      <p class={styles.statement}>{professionalFocus.statement}</p>
    </div>
  </PageContainer>
</Section>

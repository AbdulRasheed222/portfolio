---
import { homepage } from '../../config/homepage';
import PageContainer from '../layout/PageContainer.astro';
import Section from '../layout/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import styles from './EngineeringPrinciples.module.css';

const { principles } = homepage;
---

<Section mode="reading">
  <PageContainer>
    <SectionHeading
      systemIndex="03 — ENGINEERING PRINCIPLES"
      eyebrow="Principles"
      title="How engineering work is presented here"
      description="The rules that govern every publication inside Engineering OS."
      level="h2"
    />
    <ol class={styles.list}>
      {
        principles.map((principle) => (
          <li class={styles.item}>
            <span class={styles.index}>{principle.index}</span>
            <div class={styles.content}>
              <h3 class={styles.title}>{principle.title}</h3>
              <p class={styles.description}>{principle.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </PageContainer>
</Section>

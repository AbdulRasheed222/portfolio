---
import PageContainer from './PageContainer.astro';
import Section from './Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import TextLink from '../ui/TextLink.astro';
import styles from './PlaceholderPage.module.css';

interface Props {
  title: string;
  message: string;
  eyebrow?: string;
}

const { title, message, eyebrow } = Astro.props;
---

<Section>
  <PageContainer variant="reading">
    <div class={styles.placeholder}>
      <SectionHeading eyebrow={eyebrow} title={title} level="h1" />
      <p class={styles.message}>{message}</p>
      <p>
        <TextLink href="/">Return to home</TextLink>
      </p>
    </div>
  </PageContainer>
</Section>

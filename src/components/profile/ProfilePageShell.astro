---
import PageContainer from '../layout/PageContainer.astro';
import Section from '../layout/Section.astro';
import styles from './ProfilePageShell.module.css';

interface Props {
  variant?: 'reading' | 'wide';
}

const { variant = 'reading' } = Astro.props;
---

<Section variant="compact" mode="reading" reveal={false}>
  <PageContainer variant={variant === 'wide' ? 'wide' : 'reading'}>
    <div class:list={[styles.shell, variant === 'wide' && styles.shellWide]}>
      <slot />
    </div>
  </PageContainer>
</Section>

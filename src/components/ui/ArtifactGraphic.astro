---
type Visual = 'flow' | 'stack' | 'ledger';

interface Props {
  visual: Visual;
}

const { visual } = Astro.props;
---

{visual === 'flow' && (
  <svg class="artifact-graphic" viewBox="0 0 120 80" fill="none" aria-hidden="true" focusable="false">
    <circle cx="20" cy="40" r="4" fill="rgba(79, 70, 229, 0.7)" />
    <circle cx="60" cy="25" r="3" fill="rgba(45, 91, 255, 0.5)" />
    <circle cx="60" cy="55" r="3" fill="rgba(45, 91, 255, 0.5)" />
    <circle cx="100" cy="40" r="4" fill="rgba(120, 180, 255, 0.6)" />
    <path d="M 24 40 L 52 28" stroke="rgba(79, 70, 229, 0.45)" stroke-width="1" />
    <path d="M 24 40 L 52 52" stroke="rgba(79, 70, 229, 0.45)" stroke-width="1" />
    <path d="M 68 28 L 96 38" stroke="rgba(45, 91, 255, 0.4)" stroke-width="1" />
    <path d="M 68 52 L 96 42" stroke="rgba(45, 91, 255, 0.4)" stroke-width="1" />
    <rect x="8" y="68" width="104" height="1" fill="rgba(148, 163, 184, 0.2)" />
  </svg>
)}

{visual === 'stack' && (
  <svg class="artifact-graphic" viewBox="0 0 120 80" fill="none" aria-hidden="true" focusable="false">
    <rect x="30" y="12" width="60" height="14" rx="3" stroke="rgba(148, 163, 184, 0.35)" stroke-width="1" fill="rgba(16, 24, 39, 0.5)" />
    <rect x="24" y="30" width="72" height="14" rx="3" stroke="rgba(148, 163, 184, 0.4)" stroke-width="1" fill="rgba(16, 24, 39, 0.6)" />
    <rect x="18" y="48" width="84" height="14" rx="3" stroke="rgba(148, 163, 184, 0.45)" stroke-width="1" fill="rgba(16, 24, 39, 0.7)" />
    <path d="M 60 26 L 60 30" stroke="rgba(148, 163, 184, 0.3)" stroke-width="1" />
    <path d="M 60 44 L 60 48" stroke="rgba(148, 163, 184, 0.3)" stroke-width="1" />
    <circle cx="42" cy="19" r="2" fill="rgba(148, 163, 184, 0.4)" />
    <circle cx="78" cy="37" r="2" fill="rgba(148, 163, 184, 0.4)" />
    <circle cx="54" cy="55" r="2" fill="rgba(148, 163, 184, 0.5)" />
  </svg>
)}

{visual === 'ledger' && (
  <svg class="artifact-graphic" viewBox="0 0 120 80" fill="none" aria-hidden="true" focusable="false">
    <path d="M 20 20 L 100 20 L 100 60 L 20 60 Z" stroke="rgba(201, 168, 106, 0.35)" stroke-width="1" fill="rgba(12, 30, 61, 0.4)" />
    <path d="M 20 35 L 100 35" stroke="rgba(201, 168, 106, 0.25)" stroke-width="0.75" />
    <path d="M 20 48 L 100 48" stroke="rgba(201, 168, 106, 0.2)" stroke-width="0.75" />
    <path d="M 45 20 L 45 60" stroke="rgba(201, 168, 106, 0.2)" stroke-width="0.75" />
    <circle cx="32" cy="27" r="2" fill="rgba(201, 168, 106, 0.5)" />
    <path d="M 55 27 L 90 27" stroke="rgba(201, 168, 106, 0.3)" stroke-width="1" />
    <path d="M 55 41 L 85 41" stroke="rgba(201, 168, 106, 0.25)" stroke-width="1" />
    <path d="M 55 54 L 80 54" stroke="rgba(201, 168, 106, 0.2)" stroke-width="1" />
    <path d="M 12 40 L 20 40" stroke="rgba(201, 168, 106, 0.4)" stroke-width="1.25" marker-end="url(#none)" />
    <path d="M 100 40 L 108 40" stroke="rgba(45, 91, 255, 0.35)" stroke-width="1" />
  </svg>
)}

<style>
  .artifact-graphic {
    width: 100%;
    max-width: 7rem;
    height: auto;
    opacity: 0.75;
  }
</style>

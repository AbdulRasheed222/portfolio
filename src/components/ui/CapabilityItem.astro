---
import styles from './CapabilityItem.module.css';

interface Props {
  title: string;
  description: string;
  index?: number;
}

const { title, description, index } = Astro.props;
const label = index !== undefined ? String(index).padStart(2, '0') : undefined;
---

<article class={styles.item}>
  {label && <p class={styles.label}>{label}</p>}
  <h3 class={styles.title}>{title}</h3>
  <p class={styles.description}>{description}</p>
</article>

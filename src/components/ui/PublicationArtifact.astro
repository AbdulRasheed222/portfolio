---
import { isExternalUrl, withBasePath } from '../../lib/url';
import MetadataRail from './MetadataRail.astro';
import StatusChip from './StatusChip.astro';
import styles from './PublicationArtifact.module.css';

type Layout = 'flow' | 'stack' | 'ledger';
type Accent = 'cobalt' | 'indigo' | 'slate' | 'gold';

interface Props {
  referenceId: string;
  pub: string;
  title: string;
  summary: string;
  href: string;
  status: string;
  evidenceLevel: string;
  version: string;
  readTime?: string;
  layout?: Layout;
  accent?: Accent;
}

const {
  referenceId,
  pub,
  title,
  summary,
  href,
  status,
  evidenceLevel,
  version,
  readTime,
  layout = 'flow',
  accent = 'cobalt',
} = Astro.props;

const resolvedHref = isExternalUrl(href) ? href : withBasePath(href);

const statusVariant =
  status.includes('DEVELOPMENT') || status.includes('GATHERING')
    ? 'warning'
    : status.includes('COMPLETED')
      ? 'muted'
      : 'default';

const metaItems = [referenceId, pub, `EVD: ${evidenceLevel}`, version, ...(readTime ? [`READ ${readTime}`] : [])];
const accentClass = {
  cobalt: styles.accentCobalt,
  indigo: styles.accentIndigo,
  slate: styles.accentSlate,
  gold: styles.accentGold,
}[accent];
---

<article class:list={[styles.artifact, styles[layout], accentClass]} data-accent={accent}>
  <div class={styles.glow} aria-hidden="true"></div>
  <div class={styles.inner}>
    <header class={styles.header}>
      <MetadataRail items={metaItems} />
      <StatusChip variant={statusVariant}>{status}</StatusChip>
    </header>
    <h3 class={styles.title}>
      <a href={resolvedHref} class={styles.titleLink}>{title}</a>
    </h3>
    <p class={styles.summary}>{summary}</p>
    <span class={styles.action} aria-hidden="true">Open publication →</span>
  </div>
</article>

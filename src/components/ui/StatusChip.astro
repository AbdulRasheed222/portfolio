---
import styles from './StatusChip.module.css';

interface Props {
  variant?: 'default' | 'warning' | 'positive' | 'muted';
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;

const variantClass = {
  default: styles.default,
  warning: styles.warning,
  positive: styles.positive,
  muted: styles.muted,
}[variant];
---

<span class:list={[styles.chip, variantClass, className]}><slot /></span>
